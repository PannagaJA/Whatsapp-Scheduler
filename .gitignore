.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Dependencies
node_modules/
mobile-server/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
!.env.example
*.env

# SQLite Databases & Lock/Journal Files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
mobile-server/data/

# WhatsApp Multi-Device Sessions & User Uploads
auth_info_baileys/
sessions/
mobile-server/sessions/
uploads/
mobile-server/uploads/

# Android & Gradle Build Artifacts
.gradle/
build/
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.apk
*.aab
build-output/
*.jks
*.keystore
keystore.properties
signing.properties

# Logs and Runtime State
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# Test Coverage & Tooling
coverage/
.nyc_output/
*.lcov

# Internal Project Planning, Security Audits & AI Assistant Artifacts
.planning/
SECURITY_AUDIT_REPORT.md
SECURITY_REMEDIATION_CHECKLIST.md
