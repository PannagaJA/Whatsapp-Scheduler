<resources>
    <style name="Theme.WhatsAppScheduler" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- API 23+: Dark status bar icons supported -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Below API 26: Dark navigation bar icons unsupported; keep nav bar dark -->
        <item name="android:navigationBarColor">@color/background</item>
    </style>
</resources>
