<resources tools:targetApi="o_mr1" xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WhatsAppScheduler" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- API 27+: Both dark status bar and dark navigation bar icons supported -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
